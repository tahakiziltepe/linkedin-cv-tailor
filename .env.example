# Copy this file to .env and fill in your own values. (.env is git-ignored.)

# ZORUNLU — pipeline filtreleme + CV uyarlama icin Gemini API anahtari
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsiyonel — yeni uygun is ilani Telegram bildirimi
# @BotFather'dan /newbot ile bir bot olustur; token'i buraya yaz.
TELEGRAM_TOKEN=
# Bildirimin gidecegi chat: botunuzun kullandigi chat'in ID'si
TELEGRAM_CHAT_ID=

# Opsiyonel — web paneli icin zorunlu (oturum gizliligi).
# Uretmek icin: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opsiyonel — run_daily.sh günlük otomatik git push icin (PRIVATE jurnal).
# Not: kimlik bilgilerini ~/.git-credentials zaten yonetiyorsa token
# vermeseniz de push duz yol üzerinden çalışır.
GITHUB_TOKEN=
